<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="web_layout_theme_studio" inherit_id="web.layout">
        <xpath expr="//head" position="inside">
            <link rel="stylesheet" type="text/css" href="/theme_studio/style.css" id="theme_studio_styles"/>
        </xpath>
    </template>

    <template id="assets_frontend_theme_studio" inherit_id="web.assets_frontend">
        <xpath expr="." position="inside">
            <link rel="stylesheet" type="text/scss" href="/community_theme_studio/static/src/webclient/hover_menu.scss"/>
            <script type="text/javascript" src="/community_theme_studio/static/src/webclient/hover_menu.js"></script>
        </xpath>
    </template>
</odoo>
